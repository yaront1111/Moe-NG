+      # The security lane's own script typechecks the lane then runs its
+      # `*.security.ts` suffix, which no root config ever matches. Same
+      # executed-proof discipline as the root step: exit code AND a positive
+      # count line, because a lane whose include matched nothing exits 0.
+      - name: Test (security lane)
+        run: |
+          $ErrorActionPreference = 'Continue'
+          $PSNativeCommandUseErrorActionPreference = $false
+          pnpm test:security 2>&1 | Tee-Object -FilePath vitest-security.log
+          $status = $LASTEXITCODE
+          if ($status -ne 0) {
+            Write-Output "::error title=gate-windows::pnpm test:security exited $status"
+            exit 1
+          }
+          if (-not (Select-String -Path vitest-security.log -Pattern '^\s*Test Files\s+[1-9][0-9]* passed' -Quiet)) {
+            Write-Output "::error title=gate-windows::security lane ran no test file"
+            exit 1
+          }
+
+      # apps/** is invisible to the root vitest include (adapters, packages,
+      # tests only), so each app's own `test` script is the only thing that
+      # executes its colocated suites. Run SERIALLY after the root suite, not
+      # concurrently with it: several daemon suites carry wall-clock bounds that
+      # go red under machine load, and a shared runner is exactly that.
+      - name: Test (daemon app)
+        run: |
+          $ErrorActionPreference = 'Continue'
+          $PSNativeCommandUseErrorActionPreference = $false
+          pnpm --filter @moe/daemon test 2>&1 | Tee-Object -FilePath vitest-daemon.log
+          $status = $LASTEXITCODE
+          if ($status -ne 0) {
+            Write-Output "::error title=gate-windows::daemon test exited $status"
+            exit 1
+          }
+          if (-not (Select-String -Path vitest-daemon.log -Pattern '^\s*Test Files\s+[1-9][0-9]* passed' -Quiet)) {
+            Write-Output "::error title=gate-windows::daemon suite ran no test file"
+            exit 1
+          }
+
+      - name: Test (control-room app)
+        run: |
+          $ErrorActionPreference = 'Continue'
+          $PSNativeCommandUseErrorActionPreference = $false
+          pnpm --filter @moe/control-room test 2>&1 | Tee-Object -FilePath vitest-control-room.log
+          $status = $LASTEXITCODE
+          if ($status -ne 0) {
+            Write-Output "::error title=gate-windows::control-room test exited $status"
+            exit 1
+          }
+          if (-not (Select-String -Path vitest-control-room.log -Pattern '^\s*Test Files\s+[1-9][0-9]* passed' -Quiet)) {
+            Write-Output "::error title=gate-windows::control-room suite ran no test file"
+            exit 1
+          }
+
+      # node:test, not vitest: the spec reporter's summary is `ℹ pass N` /
+      # `ℹ fail 0`, so the executed-proof anchor is a positive pass count and
+      # the absence of a nonzero fail count. This is the one leg of
+      # verify:release that nothing else in CI reaches.
+      - name: Test (release supply chain)
+        run: |
+          $ErrorActionPreference = 'Continue'
+          $PSNativeCommandUseErrorActionPreference = $false
+          node --test tests/integration/release-supply-chain.test.mjs 2>&1 | Tee-Object -FilePath node-supply-chain.log
+          $status = $LASTEXITCODE
+          if ($status -ne 0) {
+            Write-Output "::error title=gate-windows::release-supply-chain test exited $status"
+            exit 1
+          }
+          if (-not (Select-String -Path node-supply-chain.log -Pattern 'pass [1-9][0-9]*' -Quiet)) {
+            Write-Output "::error title=gate-windows::supply-chain test reported no positive pass count"
+            exit 1
+          }
+          if (Select-String -Path node-supply-chain.log -Pattern 'fail [1-9][0-9]*' -Quiet) {
+            Write-Output "::error title=gate-windows::supply-chain test reported failures"
+            exit 1
+          }
+
