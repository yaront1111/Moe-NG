{
  "name": "moe-next",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Greenfield local-first multi-agent orchestration control plane",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=24.16.0 <25",
    "pnpm": "11.0.8"
  },
  "scripts": {
    "typecheck": "pnpm --recursive typecheck",
    "test": "vitest run",
    "test:meta": "vitest run packages/contracts/src packages/testkit/src",
    "test:property": "vitest run tests/property",
    "test:e2e": "tsc -p tests/e2e/foundation/tsconfig.json && vitest run tests/e2e",
    "test:e2e:browser": "tsc -p tests/e2e/control-room/tsconfig.json && playwright test -c tests/e2e/control-room/playwright.config.ts",
    "test:integration": "pnpm typecheck:packaging && vitest run tests/integration",
    "test:store": "vitest run packages/store/src",
    "typecheck:packaging": "tsc --noEmit --strict --module nodenext --moduleResolution nodenext --target es2024 --lib es2024 --types node --exactOptionalPropertyTypes --noUncheckedIndexedAccess --verbatimModuleSyntax --forceConsistentCasingInFileNames tools/packaging/distribution-build.ts tools/packaging/distribution-startup.ts",
    "verify:foundation": "pnpm typecheck && pnpm test:meta",
    "verify:store": "pnpm typecheck && pnpm test:store"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
